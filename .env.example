# Firebase (existing)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# API base URL (existing)
VITE_BASE_URL=http://localhost:3000

# Secret key to encrypt the runtime-keys request to the backend
VITE_SECRET_KEY=

# Key to decrypt the runtime-keys response payload
VITE_PLATFORM_KEY=

# Platform identity sent in the runtime-keys request
VITE_PLATFORM_NAME=

# Platform version sent in the runtime-keys request
VITE_PLATFORM_VERSION=

# UI appearance
# Set to "false" to hide tile/card outlines (default: true)
VITE_TILE_OUTLINES=true

# GitHub Dev Workflow
# Create a PAT at https://github.com/settings/tokens
# Required scopes: repo (for private repos) or public_repo (for public repos)
VITE_GIT_USERNAME=your-github-username
VITE_GIT_PAT=ghp_xxxxxxxxxxxxxxxxxxxx
